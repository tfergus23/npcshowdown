[Unit]
Description=NPC Showdown API Service
After=network.target mariadb.service
Requires=mariadb.service

[Service]
ExecStart=/npcs/npcshowdown
Restart=always
RestartSec=5
User=svcnpcshowdown
Group=svcnpcshowdown
WorkingDirectory=/npcs
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=npcshowdown
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
